# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: silabs_efr32bg22_ble_soc_lcd1602_i2c_controller
label: silabs_efr32bg22_ble_soc_lcd1602_i2c_controller
description: |
  The classic blinky example using Bluetooth communication. Demonstrates a simple two-way data exchange over GATT. This can be tested with the EFR Connect mobile app.
category: Bluetooth Examples
filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Beginner]
- name: Wireless Technology
  value: [Bluetooth]
package: Bluetooth
quality: production
readme:
- {path: readme.md}
source:
- {path: main.c}
- {path: app.c}
- {path: ble_node.c}
- {path: ble_lcd_service.c}
- {path: lcd_protocol.c}
tag: [prebuilt_demo, 'hardware:rf:band:2400', 'hardware:component:button:1+', 'hardware:!shared:button:led',
  'hardware:component:led:1+']
include:
- path: ''
  file_list:
  - {path: app.h}
  - {path: ble_node.h}
  - {path: ble_lcd_service.h}
  - {path: lcd_protocol.h}
sdk: {id: gecko_sdk, version: 4.4.5}
toolchain_settings: []
component:
- {id: EFR32BG22C224F512IM40}
- {id: app_assert}
- {id: app_log}
- {id: bluetooth_feature_connection}
- {id: bluetooth_feature_gatt_server}
- {id: bluetooth_feature_legacy_advertiser}
- {id: bluetooth_feature_system}
- {id: bluetooth_stack}
- {id: bootloader_interface}
- {id: brd4108a}
- {id: bt_post_build}
- {id: component_catalog}
- {id: gatt_configuration}
- {id: gatt_service_device_information}
- instance: [lcd1602]
  id: i2cspm
- {id: in_place_ota_dfu}
- instance: [vcom]
  id: iostream_usart
- {id: mpu}
- {id: rail_util_pti}
- instance: [btn0]
  id: simple_button
- instance: [led0]
  id: simple_led
other_file:
- {path: image/readme_img0.png}
- {path: image/readme_img1.jpg}
- {path: image/readme_img2.jpg}
- {path: image/readme_img3.jpg}
- {path: image/readme_img4.jpg}
- {path: image/readme_img5.gif}
template_contribution:
- {name: memory_ram_start, priority: 0, value: 536870912}
- {name: memory_ram_size, priority: 0, value: 32768}
- {name: memory_flash_start, priority: 0, value: 0}
- {name: memory_flash_size, priority: 0, value: 524288}
configuration:
- {name: SL_STACK_SIZE, value: '2752'}
- {name: SL_HEAP_SIZE, value: '9200'}
- condition: [iostream_usart]
  name: SL_BOARD_ENABLE_VCOM
  value: '1'
- condition: [psa_crypto]
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
ui_hints:
  highlight:
  - {path: config/btconf/gatt_configuration.btconf}
  - {path: readme.md, focus: true}

