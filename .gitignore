*.s37

# Simplicity Studio generated/scratch directories
.uceditor/
trashed_modified_files/

# Simplicity Studio / Eclipse CDT build configuration directory
GNU ARM*/

# Eclipse/CDT project metadata. .cproject and .project carry hand-tuned
# config (lib include paths, source exclusion filters) that .slcp does not
# know about and that Simplicity Studio does not reliably regenerate, so
# both are tracked. The rest below is genuinely regenerable build state.
.projectlinkstore
.settings/

# Simplicity Studio SLC internal state
.slc_state/

# Simplicity Studio workspace folder at repo root (IDE-managed, not source)
project/

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo
